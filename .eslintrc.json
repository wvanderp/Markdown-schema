{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": "airbnb-base",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "mocha"
    ],
    "rules": {
        // should use extensions for import
        "import/extensions": [
            "error",
            "ignorePackages",
            {
                "js": "always",
                "json": "always"
            }
        ],
        "no-restricted-syntax": "off",
        "linebreak-style": "off"
    }
}
