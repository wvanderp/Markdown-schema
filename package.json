{
  "name": "markdown-schema",
  "version": "1.0.0",
  "description": "A schema for validating and linting markdown files",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "eslint": "eslint .",
    "tsc": "tsc --noEmit",
    "lint": "npm run eslint && npm run tsc"
  },
  "author": "wvanderp",
  "license": "MIT",
  "dependencies": {
    "marked": "^18.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^62.9.0",
    "neostandard": "^0.13.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
